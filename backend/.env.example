SERVER_PORT=8080
CONTEXT_PATH=/api

MONGODB_URI=mongodb://localhost:27017/english_center_db

JWT_SECRET=lethinguyentrinh-english-center-ms-jwt-key-32chars
JWT_EXPIRATION_MS=3600000

TIMEZONE=Asia/Ho_Chi_Minh
# Production (HTTPS): COOKIE_SECURE=true
COOKIE_SECURE=false
# Lax when the browser talks to one origin (reverse proxy on /api). None only for cross-site (forces Secure).
COOKIE_SAMESITE=Lax
# Exact origins, comma-separated, https:// included, no trailing slash. Production example: https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SPRING_PROFILES_ACTIVE=dev
