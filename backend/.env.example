SERVER_PORT=8080
CONTEXT_PATH=/api

MONGODB_URI=mongodb://localhost:27017/english_center_db

JWT_SECRET=lethinguyentrinh-english-center-ms-jwt-key-32chars
# Access token lifetime (15 min). Sessions are renewed through the refresh token.
JWT_EXPIRATION_MS=900000
# Refresh token lifetime (7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

TIMEZONE=Asia/Ho_Chi_Minh
# Production (HTTPS): COOKIE_SECURE=true
COOKIE_SECURE=false
# Lax when the browser talks to one origin (reverse proxy on /api). None only for cross-site (forces Secure).
COOKIE_SAMESITE=Lax
# Exact origins, comma-separated, https:// included, no trailing slash. Production example: https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
SPRING_PROFILES_ACTIVE=dev

# Password reset email. Leave spring.mail.host unset in dev (codes are logged). Required when SPRING_PROFILES_ACTIVE=prod.
# spring.mail.host=smtp.example.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
MAIL_FROM=no-reply@english-center.local
OTP_TTL_MINUTES=5
# Max POSTs per IP per window on login/signup/forgot/verify/reset
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
