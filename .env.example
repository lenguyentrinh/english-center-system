# Used by docker-compose.yml (copy to .env)
# Database: leave MYSQL_URL unset to use the bundled mysql container (docker compose up).
# To use an external MySQL, set these and start without the local mysql:
#   docker compose up -d --build --no-deps backend frontend
# MYSQL_URL=jdbc:mysql://<host>:3306/english_center_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
# MYSQL_USER=root
# MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=root
JWT_SECRET=secret
JWT_EXPIRATION_MS=3600000
COOKIE_SECURE=false
# dev: OTP codes are printed to the backend log. prod: SMTP below is required.
SPRING_PROFILES_ACTIVE=dev

JWT_REFRESH_EXPIRATION_MS=604800000
COOKIE_SAMESITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# First admin, created on startup only when all three are set (roles are always seeded)
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
MAIL_FROM=no-reply@english-center.local
OTP_TTL_MINUTES=5
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Base URL of the SPA, used for the links in emails
FRONTEND_URL=http://localhost:5173
